# ===== PERFIL B: PROTEGIDO (Spring Security + API Gateway + Keycloak/OAuth2 + rate limit) =====
VULN_BOLA=false
VULN_SQLI=false
VULN_BROKEN_AUTH=false
VULN_MISCONFIG=false
ERROR_STACKTRACE=never
ACTUATOR_EXPOSE=health,info,prometheus
GATEWAY_ENFORCE=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
JWT_SECRET=troque-esta-chave-por-32-bytes-aleatorios-em-producao
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
GF_PASSWORD=admin
