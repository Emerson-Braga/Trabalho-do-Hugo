{
  "realm": "apisec",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Cliente comum" },
      { "name": "ADMIN", "description": "Administrador" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.org",
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.org",
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.org",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMIN", "USER"]
    }
  ],
  "clients": [
    {
      "clientId": "apisec-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "access.token.lifespan": "900" }
    }
  ]
}
